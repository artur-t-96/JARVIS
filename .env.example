HOST=127.0.0.1
PORT=4310
JARVIS_MODE=local
JARVIS_DATA_DIR=.data
JARVIS_PLANNER=demo
# Optional, explicit model-provider configuration (never read from other systems):
# JARVIS_PLANNER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# Authenticated mode requires a private JSON file outside the repository:
# JARVIS_MODE=authenticated
# JARVIS_AUTH_FILE=/absolute/private/path/jarvis-auth.json
